#!/bin/bash
# 重置登录口令（需 root）。账号名沿用 config.json 里记录的那个。
# 执行后重新打开门户，会回到「设置登录口令」页，可重设账号与口令。
set -u
CMD_DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# shellcheck disable=SC1091
. "$CMD_DIR/lib/common.sh"

[ "$(id -u)" = "0" ] || { echo "需要 root" >&2; exit 1; }

ACCT=$(rv_account_name)
rv_lsa_clear_password
echo "登录口令已清除（账号：${ACCT}）。"
echo "请重新打开 http://<本机IP>:2463/ ，页面会要求你重新设置账号与口令。"
